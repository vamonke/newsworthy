# Track only Newsworthy within this shared experimental workspace.
/*
!/.gitignore
!/package.json
!/package-lock.json
!/.env.example
!/NEWSWORTHY.md
!/.github/
!/.github/README.md
!/orbis-motion-test/
/orbis-motion-test/*
!/orbis-motion-test/newsworthy*.js
!/orbis-motion-test/news-design.html
!/orbis-motion-test/news-design.css
!/orbis-motion-test/news-judge-api.js
!/orbis-motion-test/news-judge.test.js
!/orbis-motion-test/news-*preview.html
!/orbis-motion-test/news-states-preview.js
!/orbis-motion-test/news-photo-preview-data.js
!/orbis-motion-test/news-photo-design.html
!/orbis-motion-test/news-results-design.html
!/orbis-motion-test/prompts.js
!/orbis-motion-test/APPROVED-OPENING.md
!/orbis-motion-test/public/
/orbis-motion-test/public/*
!/orbis-motion-test/public/news-judge/
!/orbis-motion-test/public/news-design/
!/orbis-motion-test/public/audio/
**/node_modules/
**/dist/
**/.env*
!/.env.example
**/runs/
**/*.log
**/.DS_Store
