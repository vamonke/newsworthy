# Track only Newsworthy within this shared experimental workspace.
/*
!/.gitignore
!/AGENTS.md
!/package.json
!/package-lock.json
!/.env.example
!/NEWSWORTHY.md
!/DEPLOYMENT.md
!/NEWSWORTHY-DESIGN-BRIEF.md
!/.github/
!/.github/README.md
!/orbis-motion-test/
/orbis-motion-test/*
!/orbis-motion-test/newsworthy*.js
!/orbis-motion-test/news-design.html
!/orbis-motion-test/news-wire.css
!/orbis-motion-test/news-loading-motion.css
!/orbis-motion-test/news-popups.css
!/orbis-motion-test/news-judge-api.js
!/orbis-motion-test/news-judge.test.js
!/orbis-motion-test/prompts.js
!/orbis-motion-test/APPROVED-OPENING.md
!/orbis-motion-test/public/
/orbis-motion-test/public/*
!/orbis-motion-test/public/og-image.png
!/orbis-motion-test/public/news-judge/
!/orbis-motion-test/public/news-design/
!/orbis-motion-test/public/audio/
**/node_modules/
**/dist/
**/.env*
!/.env.example
**/runs/
**/*.log
**/.DS_Store
/.codex-work/

!orbis-motion-test/news-flat.css

!orbis-motion-test/newsworthy-motion.js

!orbis-motion-test/newsworthy-stars.js
!/orbis-motion-test/news-intro*.css

# Design previews, spikes and their images; kept locally, not tracked.
/orbis-motion-test/public/news-design/*
!/orbis-motion-test/public/news-design/newsworthy-icon.svg
!/orbis-motion-test/public/news-design/newsworthy-mark.svg
!/orbis-motion-test/public/news-design/wire-paper-texture.webp
/orbis-motion-test/public/news-judge/*
!/orbis-motion-test/public/news-judge/busy-opening-ufo-v4.png
!/orbis-motion-test/public/news-judge/ordinary.jpg

# Cloudflare Worker (production)
!/worker/
!/orbis-motion-test/public/.assetsignore
/worker/.dev.vars
**/.wrangler/
